<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything a host needs, with no console or argv (architecture.md §1). -->
  <PropertyGroup>
    <RootNamespace>Blokky.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Scanner and Parser only, behind Reading/Yaml/IYamlFrontEnd (ADR 0008); pinned, upgrades rerun the suite. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blokky.Core.Tests" />
  </ItemGroup>
</Project>
